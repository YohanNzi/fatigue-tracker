# Copier en .env (ignoré par git) pour surcharger les identifiants Postgres locaux.
# Ces valeurs sont des defaults de dev, pas des secrets de production.
POSTGRES_DB=fatiguetracker
POSTGRES_USER=fatiguetracker
POSTGRES_PASSWORD=fatiguetracker
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# JWT (J3) : application.yml fournit un default "dev only" si absent, mais À SURCHARGER
# obligatoirement en dehors d'un poste de dev local (voir README, section Sécurité).
# JWT_SECRET=<votre-secret-base64-256-bits-minimum>
# JWT_EXPIRATION_MINUTES=60
